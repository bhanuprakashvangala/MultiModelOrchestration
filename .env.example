# Copy to .env and fill in. Never commit .env.
# mmorch reads only the environment, never .env itself: load it with  set -a; source .env; set +a

# OpenAI-compatible endpoint serving the models (mmorch route, mmorch baseline, mmorch score)
LLM_API_BASE=https://your-llm-endpoint.example.org/v1
LLM_API_KEY=your_api_key_here

# Served model names per tier for mmorch route (defaults are the names used in the recorded runs)
MODEL_LOW=llama3
MODEL_MEDIUM=qwen3
MODEL_HIGH=deepseek-r1
MODEL_CLASSIFIER=llama3

# Hugging Face token for gated weights (Helm charts)
HF_TOKEN=

# Matrix prototype (mmorch serve; --namespace, --chart-dir, --host and --port take precedence)
KUBERNETES_NAMESPACE=default
MATRIX_CHART_DIR=./deploy/helm/pick-and-spin-umbrella
API_HOST=localhost
API_PORT=8080
