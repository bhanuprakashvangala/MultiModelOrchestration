# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible endpoint serving the models (src/routing, src/baseline)
LLM_API_BASE=https://your-llm-endpoint.example.org/v1
LLM_API_KEY=your_api_key_here

# Served model names per tier (defaults are the names used in the recorded runs)
MODEL_LOW=llama3
MODEL_MEDIUM=qwen3
MODEL_HIGH=deepseek-r1
MODEL_CLASSIFIER=llama3

# Hugging Face token for gated weights (Helm charts)
HF_TOKEN=

# Matrix prototype (src/matrix)
KUBERNETES_NAMESPACE=default
MATRIX_CHART_DIR=./deploy/helm/pick-and-spin-umbrella
API_HOST=localhost
API_PORT=8080
